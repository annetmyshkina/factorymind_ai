APP_NAME=FactoryMind AI
APP_VERSION=0.1.0
ENVIRONMENT=development

POSTGRES_USER=factorymind
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=factorymind

# MQTT и демонстрационный симулятор. Коды оборудования должны существовать в БД.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TELEMETRY_TOPIC=factorymind/equipment/+/telemetry
SIMULATOR_EQUIPMENT_CODES=CMP-01,CMP-02,CMP-03
SIMULATOR_SCENARIO=demo_cycle
SIMULATOR_INTERVAL_SECONDS=2
SIMULATOR_STEPS=0
SIMULATOR_SEED=42
SIMULATOR_DROP_RATE=0
SIMULATOR_DUPLICATE_RATE=0
SIMULATOR_DELAY_RATE=0
SIMULATOR_DELAY_STEPS=2

# Провайдеры LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=60
EXPERIMENT_WORKER_LEASE_SECONDS=120
EXPERIMENT_WORKER_POLL_SECONDS=1
EXPERIMENT_MAX_ATTEMPTS=3
EXPERIMENT_RETRY_BASE_SECONDS=5
EXPERIMENT_WORKER_METRICS_HOST=127.0.0.1
EXPERIMENT_WORKER_METRICS_PORT=9101

# Локальная Grafana. Обязательно смените пароль вне локальной разработки.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# BASE_URL обязателен, MODEL можно переопределить в запросе.
COMPATIBLE_BASE_URL=https://api.vsegpt.ru/v1
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_AUTH_SCHEME=Bearer
